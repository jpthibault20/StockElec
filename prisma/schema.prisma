// Database schema for stockElec (Supabase PostgreSQL), spec section 5.
//
// Prisma owns tables, columns, enums and indexes. RLS policies, grants,
// triggers, check constraints and Storage setup are written as SQL inside the
// migrations (`npm run db:migrate -- --name <name> --create-only`, then edit).
// No client generator: the app talks to the database through supabase-js, so
// every default is generated by the database (`dbgenerated`), never by Prisma.
//
// Every table carries `user_id` (defaults to `auth.uid()`) for RLS.

datasource db {
  provider = "postgresql"
}

enum ItemType {
  component
  consumable
  tool
  printing_3d

  @@map("item_type")
}

enum QuantityUnit {
  piece
  meter
  gram
  spool

  @@map("quantity_unit")
}

enum QuantityMode {
  exact
  approximate

  @@map("quantity_mode")
}

// Bulk stock without an exact count: Beaucoup / Un peu / Presque vide.
enum ApproxLevel {
  plenty
  some
  almost_empty

  @@map("approx_level")
}

enum MovementType {
  add
  remove
  move

  @@map("movement_type")
}

// Free tree: Atelier > Meuble A > Tiroir 3 > Boîte 2.
// The printable QR code encodes the location id, so no extra column.
model Location {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  parentId  String?         @map("parent_id") @db.Uuid
  name      String
  // Free label: meuble, tiroir, boîte, carton…
  kind      String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent    Location?       @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[]      @relation("LocationTree")
  items     Item[]
  movesFrom StockMovement[] @relation("MoveFrom")
  movesTo   StockMovement[] @relation("MoveTo")

  @@index([userId])
  @@index([parentId])
  @@map("locations")
}

model Category {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  parentId     String?    @map("parent_id") @db.Uuid
  name         String
  // Structured parameters for items of this category, e.g.
  // [{ "key": "resistance", "label": "Valeur", "type": "number", "unit": "Ω" }].
  paramsSchema Json       @default("[]") @map("params_schema")
  // Item type of a root category (sub-categories inherit it); filters the
  // categories offered in the item form.
  itemType     ItemType?  @map("item_type")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryTree")
  items        Item[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

model Item {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String             @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  type          ItemType
  name          String
  categoryId    String?            @map("category_id") @db.Uuid
  locationId    String?            @map("location_id") @db.Uuid
  mpn           String?
  manufacturer  String?
  // Footprint: 0805, SOT-23, DIP-8…
  package       String?
  // EAN / UPC of consumer products, so a second scan finds the item.
  barcode       String?
  // Technical parameters, keys defined by the category params schema.
  params        Json               @default("{}")
  quantity      Decimal            @default(0) @db.Decimal(12, 3)
  unit          QuantityUnit       @default(piece)
  quantityMode  QuantityMode       @default(exact) @map("quantity_mode")
  // Only used when quantityMode = approximate.
  approxLevel   ApproxLevel?       @map("approx_level")
  // Low-stock threshold in `unit`; null = alert disabled.
  minThreshold  Decimal?           @map("min_threshold") @db.Decimal(12, 3)
  datasheetUrl  String?            @map("datasheet_url")
  notes         String?
  tags          String[]           @default([])
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location      Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  photos        ItemPhoto[]
  links         ItemLink[]
  filament      Filament?
  movements     StockMovement[]
  shoppingItems ShoppingListItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([locationId])
  @@index([mpn])
  @@index([barcode])
  @@index([params], type: Gin)
  @@index([tags], type: Gin)
  @@map("items")
}

model ItemPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  // Object path in the `item-photos` bucket: <user_id>/<item_id>/<file>.
  storagePath String   @map("storage_path")
  position    Int      @default(0)
  // Raw answer of the AI identification (prepared for after V1, unused now).
  aiResult    Json?    @map("ai_result")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_photos")
}

model ItemLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  supplier  String
  url       String
  // Indicative unit price, in euros.
  unitPrice Decimal? @map("unit_price") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_links")
}

// 3D printing filament details, one-to-one with an item of type printing_3d.
// The brand is the item's manufacturer.
model Filament {
  itemId      String    @id @map("item_id") @db.Uuid
  userId      String    @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  // PLA, PETG, ABS, TPU…
  material    String
  colorHex    String?   @map("color_hex")
  diameterMm  Decimal   @default(1.75) @map("diameter_mm") @db.Decimal(4, 2)
  remainingG  Decimal?  @map("remaining_g") @db.Decimal(8, 1)
  tareG       Decimal?  @map("tare_g") @db.Decimal(8, 1)
  nozzleTempC Int?      @map("nozzle_temp_c")
  bedTempC    Int?      @map("bed_temp_c")
  openedOn    DateTime? @map("opened_on") @db.Date
  driedOn     DateTime? @map("dried_on") @db.Date
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("filaments")
}

// Empty spool weight per brand, reused to compute remaining filament.
model SpoolTare {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  brand     String
  tareG     Decimal  @map("tare_g") @db.Decimal(8, 1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, brand])
  @@map("spool_tares")
}

model StockMovement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  type           MovementType
  // Signed quantity change; 0 for a move.
  delta          Decimal      @default(0) @db.Decimal(12, 3)
  fromLocationId String?      @map("from_location_id") @db.Uuid
  toLocationId   String?      @map("to_location_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation   Location?    @relation("MoveFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location?    @relation("MoveTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// Manual shopping entries and purchase state. Items under their threshold are
// computed by the app; a row with no item is a free-text entry (label).
model ShoppingListItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  itemId    String?  @map("item_id") @db.Uuid
  label     String?
  quantity  Decimal  @default(1) @db.Decimal(12, 3)
  purchased Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemId])
  @@map("shopping_list")
}
