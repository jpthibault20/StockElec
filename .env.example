# stockElec — environment template.
# Copy to .env.local (or .env) and fill in the values. Never commit the real file.
# NEXT_PUBLIC_* values are public: the publishable key is protected by Row Level Security.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# V1 has no active AI: keep false to hide AI entry points. Enabling also needs the
# ANTHROPIC_API_KEY secret on the Edge Function (npx supabase secrets set ...),
# never in this file.
NEXT_PUBLIC_AI_ENABLED=false

# Server-side only (Prisma CLI, migrations). Never prefix with NEXT_PUBLIC_.
# Supabase → Connect → ORMs / Session pooler (port 5432, IPv4), with your DB password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Public URL of the deployed app (e.g. https://stockelec.vercel.app), encoded in
# printed QR labels. Optional: defaults to the current origin.
NEXT_PUBLIC_APP_URL=
